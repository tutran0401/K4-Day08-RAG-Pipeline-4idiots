# OpenRouter API Key (Khuyên dùng cho bài lab - có model free :free)
OPENROUTER_API_KEY=sk-or-v1-...
# Router miễn phí phù hợp để demo; có thể đổi sang model cụ thể trên OpenRouter
LLM_MODEL=openrouter/free

# OpenAI API Key (Tùy chọn - fallback nếu OpenRouter bị 429 rate limit)
# OPENAI_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=...

# PageIndex API Key (Tùy chọn - dùng cho Task 8: Vectorless RAG fallback)
# PAGEINDEX_API_KEY=pix_...
# PAGEINDEX_REMOTE=1  # opt-in: tạo retrieval task/upload ngoài hệ thống, có thể tốn quota

# Embedding production (mặc định là hashing local, không cần download model)
# RAG_EMBEDDING_BACKEND=sentence_transformer
# RAG_EMBEDDING_MODEL=BAAI/bge-m3

# Lexical backend bonus: bm25 (mặc định) hoặc tfidf
# LEXICAL_METHOD=tfidf

# Chạy RAGAS LLM judge thay cho proxy metrics offline
# RAGAS_USE_LLM=1

# Jina API Key (Tùy chọn - dùng cho Task 7: Cross-encoder reranking via Jina API)
# JINA_API_KEY=jina_...

# Tên biến tương thích với hướng dẫn upstream (alias của RAG_EMBEDDING_BACKEND)
# EMBEDDING_PROVIDER=sentence_transformers  # Đã implement; local, tải model/torch khá nặng
# Hai hướng mở rộng upstream bên dưới CHƯA được dispatch trong code nhóm hiện tại:
# EMBEDDING_PROVIDER=google  # Gợi ý: models/text-embedding-004, GEMINI_API_KEY, 768 chiều
# EMBEDDING_PROVIDER=openai  # Gợi ý: text-embedding-3-small, OPENAI_API_KEY, 1536 chiều
# Lưu ý: đổi provider/model/dimension phải rebuild data/index và Chroma collection.
